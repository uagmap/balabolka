ADMIN_USERNAME=""
API_KEY_TELEGRAM=""
NETWORK_ALARM_DIR=""
SMB_USERNAME=""
SMB_PASSWORD=""
SMB_RETRY_DELAY_SECONDS="10"
SMB_RETRY_MAX_ATTEMPTS="-1"
NETWORK_ERROR_RESTART_THRESHOLD="8"
NETWORK_ERROR_RESTART_WINDOW_SECONDS="120"

# Optional Telegram routing settings
# Leave empty / unset for direct Telegram API access.
# Set these only when you want proxy routing (for sidecar xray use http://xray:8080).
TELEGRAM_PROXY_URL="http://xray:8080"
TELEGRAM_UPDATES_PROXY_URL="http://xray:8080"

# Optional custom Bot API endpoints (advanced)
# Default Bot API base URL is https://api.telegram.org/bot
# Default file base URL is https://api.telegram.org/file/bot
TELEGRAM_BASE_URL=""
TELEGRAM_BASE_FILE_URL=""

# Bot self-heal monitor.
POLLING_MONITOR_ENABLED="true"
POLLING_MONITOR_INTERVAL_SECONDS="20"
POLLING_MONITOR_RESTART_THRESHOLD="3"

# Optional self-heal watchdog for proxy outages.
WATCHDOG_ENABLED="true"
WATCHDOG_PROXY_URL="http://xray:8080"
# Leave empty to auto-probe Telegram getMe using API_KEY_TELEGRAM.
WATCHDOG_CHECK_URL=""
WATCHDOG_INTERVAL_SECONDS="20"
WATCHDOG_FAIL_THRESHOLD="4"
WATCHDOG_RESTART_COOLDOWN_SECONDS="20"
